# ==============================================================================
# WorldMonitor - Linux VPS Production Environment Configuration
# ==============================================================================
# Copy this file to .env and populate your secrets:
#   cp .env.production.example .env

# ── Server & Runtime Configuration ──────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DIST_DIR=./dist
API_DIR=./api

# ── AIS & OpenSky Relay Configuration ─────────────────────────────────────────
RELAY_PORT=3004
RELAY_HOST=127.0.0.1
# URL used by server-side API handlers to reach the local relay process
WS_RELAY_URL=http://127.0.0.1:3004
# Secret token shared between Web API handlers and the Relay process (generate a secure random string)
RELAY_SHARED_SECRET=wm_relay_prod_change_this_to_a_secure_random_string
RELAY_AUTH_HEADER=x-relay-key
# Set to true only for local unauthenticated testing; keep false in production
ALLOW_UNAUTHENTICATED_RELAY=false

# ── CORS & Allowed Origins ────────────────────────────────────────────────────
# Comma-separated list of allowed domains / origins for self-hosted instances
# Example: https://monitor.mydomain.com,http://192.168.1.100:3000
ALLOWED_ORIGINS=https://worldmonitor.app,https://tech.worldmonitor.app,https://finance.worldmonitor.app

# ── Upstream Feed API Keys (Populate as needed) ───────────────────────────────

# AIS Live Marine Tracking (Free key at https://aisstream.io)
AISSTREAM_API_KEY=

# OpenSky Military & Civil Flight Tracking (OAuth credentials from https://opensky-network.org)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# NASA FIRMS Thermal & Wildfire Detections (Free key at https://firms.modaps.eosdis.nasa.gov/api/map_key)
NASA_FIRMS_API_KEY=

# ACLED Conflict Data (https://developer.acleddata.com)
ACLED_ACCESS_TOKEN=

# US Energy Information Administration (EIA) (https://www.eia.gov/opendata/)
EIA_API_KEY=

# Federal Reserve Economic Data (FRED) (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Finnhub Financial Markets (https://finnhub.io)
FINNHUB_API_KEY=

# Cloudflare Radar BGP / Internet Outage Data (https://dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_TOKEN=

# Wingbits Flight Enrichment (optional)
WINGBITS_API_KEY=

# AI Summarization / Intel (optional)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Telegram Early Signal Feed (optional MTProto session)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_CHANNEL_SET=

# Redis Caching (optional Upstash or local Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Client Variant Build Options (full | tech | finance | happy) ─────────────
VITE_VARIANT=full

