# ==============================================================================
# WorldMonitor - Production Environment Configuration Reference (.env)
# ==============================================================================
# Copy this file to .env and configure your secrets:
#   cp .env.production.example .env
#
# Sections:
#   1. Core Server & Host Configuration
#   2. CORS & Allowed Domains
#   3. AIS & OpenSky WebSocket Relay Configuration
#   4. Aviation & Military Flight Telemetry
#   5. Conflict & Geopolitical Intelligence (UCDP, ACLED, Oref)
#   6. Wildfires, Earth Sciences & Weather (NASA FIRMS, AQICN, Safecast)
#   7. Energy, Macroeconomics, Trade & Financial Markets
#   8. Cyber Threat Intelligence & Internet Health (Cloudflare, OTX, URLhaus)
#   9. Social Intel, News & Search Feeds (Telegram, Bluesky, Brave, Exa)
#  10. LLM & AI Summarization Providers (Groq, Gemini, OpenRouter, Ollama)
#  11. Cache & Database Infrastructure (Redis, Upstash, Convex)
#  12. Access Control, Monetization & API Security
#  13. Frontend Build & Client UI Flags (Vite / Browser)
#  14. Desktop & Sidecar Flags (Tauri Internal)
# ==============================================================================


# ──────────────────────────────────────────────────────────────────────────────
# 1. Core Server & Host Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Environment mode: production | development | test
NODE_ENV=production

# Server HTTP listen port
PORT=3000

# Server HTTP listen host (0.0.0.0 binds to all network interfaces on Linux VPS)
HOST=0.0.0.0

# Directory containing Vite built frontend assets
DIST_DIR=./dist

# Directory containing Edge / API serverless route handlers
API_DIR=./api

# Content Security Policy header override (optional; leave blank to use secure default)
CSP_HEADER=


# ──────────────────────────────────────────────────────────────────────────────
# 2. CORS & Allowed Domains (Self-Hosting / Reverse Proxy)
# ──────────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed web origins for self-hosted instances.
# Same-origin requests matching the request Host header are automatically permitted.
# Example: https://monitor.example.com,http://192.168.1.100:3000
ALLOWED_ORIGINS=https://worldmonitor.app,https://tech.worldmonitor.app,https://finance.worldmonitor.app

# Client build-time alias for allowed origins
VITE_ALLOWED_ORIGINS=

# Additional allowed origins applied specifically to the AIS/OpenSky relay process
RELAY_ALLOWED_ORIGINS=


# ──────────────────────────────────────────────────────────────────────────────
# 3. AIS & OpenSky WebSocket Relay Configuration (scripts/ais-relay.cjs)
# ──────────────────────────────────────────────────────────────────────────────
# Internal HTTP and WebSocket listen port for the relay process
RELAY_PORT=3004

# Internal listen host for the relay process
RELAY_HOST=127.0.0.1

# HTTP/WebSocket URL used by server-side API handlers to call the relay process
WS_RELAY_URL=http://127.0.0.1:3004

# Browser/client fallback relay URL (used in local development)
VITE_WS_RELAY_URL=

# Shared secret key used to authenticate internal requests between API server and relay
RELAY_SHARED_SECRET=change_this_to_a_secure_random_string_32_chars_or_more

# HTTP header carrying the shared secret
RELAY_AUTH_HEADER=x-relay-key

# Set to true only for temporary unauthenticated testing. Keep false in production!
ALLOW_UNAUTHENTICATED_RELAY=false

# Allow *.vercel.app origins on the relay
ALLOW_VERCEL_PREVIEW_ORIGINS=false

# Disable upstream connection to aisstream.io
DISABLE_AISSTREAM=false

# Disable automatic financial market pre-seeding on relay startup
DISABLE_RELAY_MARKET_SEED=false

# Free API key from https://aisstream.io for live vessel tracking
AISSTREAM_API_KEY=

# Local dev fallback for AIS key
VITE_AISSTREAM_API_KEY=

# Custom upstream WebSocket stream endpoint
AISSTREAM_URL=wss://stream.aisstream.io/v0/stream

# Relay rate limits (requests per window)
RELAY_RATE_LIMIT_MAX=1200
RELAY_RATE_LIMIT_WINDOW_MS=60000
RELAY_OPENSKY_RATE_LIMIT_MAX=600
RELAY_RSS_RATE_LIMIT_MAX=300
RELAY_OREF_RATE_LIMIT_MAX=120
RELAY_GOOGLE_FLIGHTS_RATE_LIMIT_MAX=120

# Throttle interval for repeated relay logs (ms)
RELAY_LOG_THROTTLE_MS=10000

# Relay sliding window for metrics aggregation (seconds)
RELAY_METRICS_WINDOW_SECONDS=60

# RSS Memory cap in GB before forcing aggressive garbage collection (default: 0.45)
RELAY_MEMORY_CLEANUP_GB=0.45

# Vessel tracking in-memory buffer capacities
AIS_MAX_VESSELS=50000
AIS_MAX_VESSEL_HISTORY=50000
AIS_POSITION_FRESHNESS_MS=300000
AIS_MAX_CANDIDATE_REPORTS=5000
AIS_SNAPSHOT_INTERVAL_MS=60000
AIS_RECONNECT_BASE_MS=2000
AIS_RECONNECT_MAX_MS=60000
AIS_THROTTLE_RECONNECT_MAX_MS=1800000
AIS_THROTTLE_ESCALATE_AFTER=3

# Upstream queue backpressure flow-control
AIS_UPSTREAM_QUEUE_HIGH_WATER=4000
AIS_UPSTREAM_QUEUE_LOW_WATER=1000
AIS_UPSTREAM_QUEUE_HARD_CAP=8000
AIS_UPSTREAM_DRAIN_BATCH=250
AIS_UPSTREAM_DRAIN_BUDGET_MS=20
AIS_HANDSHAKE_TIMEOUT_MS=15000


# ──────────────────────────────────────────────────────────────────────────────
# 4. Aviation & Military Flight Telemetry
# ──────────────────────────────────────────────────────────────────────────────
# OpenSky Network OAuth Client Credentials (https://opensky-network.org)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# OpenSky cache tuning
OPENSKY_CACHE_TTL_MS=60000
OPENSKY_CACHE_MAX_ENTRIES=200
OPENSKY_NEGATIVE_CACHE_TTL_MS=30000
OPENSKY_NEGATIVE_CACHE_MAX_ENTRIES=100
OPENSKY_429_COOLDOWN_MS=60000
OPENSKY_REQUEST_SPACING_MS=1000
OPENSKY_BBOX_QUANT_STEP=0.5
OPENSKY_PROXY_AUTH=

# Wingbits flight tracking & ADS-B military enrichment key
WINGBITS_API_KEY=

# AviationStack API key for commercial flight delays (https://aviationstack.com)
AVIATIONSTACK_API=

# International Civil Aviation Organization (ICAO) API Key
ICAO_API_KEY=

# NASA DIP (Data and Information Platform) NOTAM Feed API
NASA_DIP_API_KEY=
NASA_DIP_NOTAM_URL=

# Google Flights 429 backoff cooldown (ms)
GF_429_COOLDOWN_MS=120000


# ──────────────────────────────────────────────────────────────────────────────
# 5. Conflict & Geopolitical Intelligence
# ──────────────────────────────────────────────────────────────────────────────
# Uppsala Conflict Data Program API Access Token (https://ucdp.uu.se/apidocs/)
UCDP_ACCESS_TOKEN=
UC_DP_KEY=

# Armed Conflict Location & Event Data Project (https://developer.acleddata.com)
ACLED_ACCESS_TOKEN=

# GDELT Project API Key (optional)
GDELT_API_KEY=

# Israel Home Front Command (Oref) Red Alert Siren integration
OREF_DATA_DIR=
OREF_POLL_INTERVAL_MS=3000
OREF_PROXY_AUTH=


# ──────────────────────────────────────────────────────────────────────────────
# 6. Wildfires, Earth Sciences & Weather
# ──────────────────────────────────────────────────────────────────────────────
# NASA FIRMS Map Key for real-time satellite fire detections (https://firms.modaps.eosdis.nasa.gov/api/map_key)
NASA_FIRMS_API_KEY=

# General NASA Open API key (https://api.nasa.gov)
NASA_API_KEY=

# World Air Quality Index Project token (https://aqicn.org/api/)
AQICN_TOKEN=

# Safecast Radiation sensor network API key (https://safecast.org)
SAFECAST_API_KEY=


# ──────────────────────────────────────────────────────────────────────────────
# 7. Energy, Macroeconomics, Trade & Financial Markets
# ──────────────────────────────────────────────────────────────────────────────
# US Energy Information Administration (EIA) API v2 key (https://www.eia.gov/opendata/)
EIA_API_KEY=

# Federal Reserve Economic Data (FRED) API key (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# World Trade Organization (WTO) API key
WTO_API_KEY=

# Finnhub Stock API key for macroeconomic tickers and commodities (https://finnhub.io)
FINNHUB_API_KEY=

# CoinGecko API keys for crypto prices and stablecoin market caps (https://www.coingecko.com/en/api)
COINGECKO_API_KEY=
COINGECKO_DEMO_API_KEY=

# Polymarket prediction market layer flag (true/false)
POLYMARKET_ENABLED=true

# Yahoo Finance quote refresh interval (ms)
MARKET_YAHOO_REFRESH_INTERVAL_MS=60000


# ──────────────────────────────────────────────────────────────────────────────
# 8. Cyber Threat Intelligence & Internet Health
# ──────────────────────────────────────────────────────────────────────────────
# Cloudflare Radar API token for BGP anomalies, route leaks, and Internet outages
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_RADAR_API_TOKEN=
CF_API_TOKEN=
CF_RADAR_API_TOKEN=
CF_RADAR_TOKEN=

# AlienVault Open Threat Exchange (OTX) API key (https://otx.alienvault.com)
OTX_API_KEY=

# Abuse.ch URLhaus API key for malicious URLs and C2 tracking (https://urlhaus.abuse.ch/api/)
URLHAUS_AUTH_KEY=

# AbuseIPDB API key for malicious IP verification (https://www.abuseipdb.com/api)
ABUSEIPDB_API_KEY=


# ──────────────────────────────────────────────────────────────────────────────
# 9. Social Intel, News & Search Feeds
# ──────────────────────────────────────────────────────────────────────────────
# Telegram MTProto client credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram String Session generated via `npm run telegram:session`
TELEGRAM_SESSION=

# Comma-separated list of Telegram channels to monitor or predefined preset name
TELEGRAM_CHANNEL_SET=

# Secret key required to query the /api/telegram-feed endpoint
TELEGRAM_API_KEY=

# Telegram poller loop tuning
TELEGRAM_POLL_INTERVAL_MS=60000
TELEGRAM_MAX_FEED_ITEMS=100
TELEGRAM_MAX_TEXT_CHARS=600
TELEGRAM_RATE_LIMIT_MS=1000
TELEGRAM_STARTUP_DELAY_MS=5000

# Bluesky / AT Protocol API key for live OSINT posts
BLUESKY_API_KEY=

# Brave Search API key(s) for live search (https://brave.com/search/api/)
BRAVE_API_KEY=
BRAVE_API_KEYS=

# Exa.ai neural search API key(s) for deep web retrieval (https://exa.ai)
EXA_API_KEYS=

# Reddit OAuth API credentials (optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# ScrapeCreators social scraper API key (optional)
SCRAPECREATORS_API_KEY=

# Optional proxy URL for YouTube live stream embedding
YOUTUBE_PROXY_URL=


# ──────────────────────────────────────────────────────────────────────────────
# 10. LLM & AI Summarization Providers
# ──────────────────────────────────────────────────────────────────────────────
# Groq Cloud API key for ultra-fast Llama-3 inference (https://console.groq.com)
GROQ_API_KEY=

# Google Gemini API key (https://aistudio.google.com)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# OpenRouter API key for unified multi-provider LLM fallback (https://openrouter.ai)
OPENROUTER_API_KEY=

# Anthropic Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Local Ollama endpoint for self-hosted AI summarization
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3:8b

# Google Cloud Translation API key for foreign language news translation
GOOGLE_TRANSLATE_API_KEY=


# ──────────────────────────────────────────────────────────────────────────────
# 11. Cache & Database Infrastructure
# ──────────────────────────────────────────────────────────────────────────────
# Upstash Redis REST credentials for distributed edge caching (https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_ALLOW_INSECURE_HTTP=false

# Redis RSS/News feed caching keys
REDIS_FEED_KEY=wm:feeds:cache
REDIS_FEED_TTL_SECONDS=3600

# Convex Cloud database URL (for desktop user interest registrations)
CONVEX_URL=


# ──────────────────────────────────────────────────────────────────────────────
# 12. Access Control, Monetization & API Security
# ──────────────────────────────────────────────────────────────────────────────
# Comma-separated list of valid client keys for authenticated API access
WORLDMONITOR_VALID_KEYS=
WORLDMONITOR_RELAY_KEY=

# Set to true only in test harnesses to bypass all API key validation
I_UNDERSTAND_THIS_DISABLES_AUTH=false

# Dodo Payments credentials for Pro subscriptions
DODO_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=live

# Pro embedded widget authorization keys
PRO_WIDGET_KEY=
WIDGET_AGENT_KEY=

# Upstream proxy URL override for outbound HTTP requests
PROXY_URL=


# ──────────────────────────────────────────────────────────────────────────────
# 13. Frontend Build & Client UI Flags (Vite / Browser Bundler)
# ──────────────────────────────────────────────────────────────────────────────
# Dashboard UI variant: full (default) | tech | finance | happy
VITE_VARIANT=full

# MapTiler Cloud API key for vector basemaps & weather radar (https://cloud.maptiler.com)
VITE_MAPTILER_API_KEY=

# Client-side toggle for live marine AIS tracking layer
VITE_ENABLE_AIS=true

# Client-side toggle for live cyber threats layer
VITE_ENABLE_CYBER_LAYER=true

# Map interaction mode
VITE_MAP_INTERACTION_MODE=

# PostHog Product Analytics credentials
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=/ingest

# Sentry frontend error reporting DSN
VITE_SENTRY_DSN=

# End-to-end test flag
VITE_E2E=false


# ──────────────────────────────────────────────────────────────────────────────
# 14. Desktop & Sidecar Flags (Tauri Internal - leave default for web/VPS)
# ──────────────────────────────────────────────────────────────────────────────
VITE_DESKTOP_RUNTIME=
VITE_TAURI_API_BASE_URL=
VITE_TAURI_REMOTE_API_BASE_URL=
LOCAL_API_PORT=46123
LOCAL_API_PORT_FILE=
LOCAL_API_MODE=desktop-sidecar
LOCAL_API_REMOTE_BASE=https://worldmonitor.app
LOCAL_API_CLOUD_FALLBACK=false
LOCAL_API_DATA_DIR=
LOCAL_API_RESOURCE_DIR=
LOCAL_API_TOKEN=
