[Unit]
Description=WorldMonitor AIS & OpenSky WebSocket Relay Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/worldmonitor

# Load production environment variables
EnvironmentFile=-/var/www/worldmonitor/.env
EnvironmentFile=-/etc/worldmonitor/worldmonitor.env

Environment=NODE_ENV=production
Environment=PORT=3004

ExecStart=/usr/bin/node scripts/ais-relay.cjs

Restart=always
RestartSec=5

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

# Resource limits
LimitNOFILE=65536

# Standard logging to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=worldmonitor-relay

[Install]
WantedBy=multi-user.target

